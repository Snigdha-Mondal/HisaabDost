# ==============================================================================
# HisaabDost (हिसाब दोस्त) — Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Google Gemma 2 / Generative AI Configuration
# (Can use Google AI Studio API key or local HuggingFace / Ollama endpoint)
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here
GEMMA_MODEL_NAME=gemma-2-9b-it
USE_LOCAL_GEMMA=false

# Prior Labs TabPFN-3.5 Anomaly Engine
TABPFN_API_KEY=your_tabpfn_api_key_here
TABPFN_ANOMALY_THRESHOLD_PCT=8.0

# ElevenLabs Telephony Voice Synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB  # Warm, patient voice (Adam/Indian-accented)

# Temporal Durable Execution
TEMPORAL_HOST_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hisaabdost-voice-queue

# Tiger Data / pgvector / MongoDB Atlas
TIGER_DATA_URI=postgresql://user:password@localhost:5432/hisaabdost
MONGODB_URI=mongodb://localhost:27017/hisaabdost

# Twilio Telephony Bridge (Optional for live phone line)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry Tracing & Observability
SENTRY_DSN=
